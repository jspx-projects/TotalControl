{
  "schema": 1,
  "id": "mackie_control",
  "name": "Mackie Control",
  "version": "1.0",
  "shape": "surface",
  "match": [
    "Fireface UC",
    "Fireface UCX",
    "Babyface"
  ],
  "channels": 8,
  "port": {
    "source": "device",
    "devices": 2,
    "direction": "duplex"
  },
  "assignment": {
    "enabled_by": "protocol",
    "controls": [
      "select",
      "mute",
      "solo",
      "rec",
      "vpot_push"
    ],
    "choices": [
      "none",
      "strip_mute",
      "strip_solo",
      "strip_select",
      "submix_select"
    ]
  },
  "options": [
    {
      "key": "submix_linked",
      "label": "Submix linked",
      "form": "checkbox",
      "group": "mapping",
      "default": true,
      "maps_to": "submix_linked"
    },
    {
      "key": "protocol",
      "label": "Enable Mackie protocol",
      "form": "checkbox",
      "group": "mapping",
      "default": true,
      "maps_to": "protocol_support",
      "help": "Accept the full Mackie protocol. When off, only the simple CC commands work."
    },
    {
      "key": "full_lcd",
      "label": "Full LCD support",
      "form": "checkbox",
      "group": "surface",
      "default": true,
      "maps_to": "full_lcd",
      "requires": "protocol"
    },
    {
      "key": "send_names",
      "label": "Send user defined names",
      "form": "checkbox",
      "group": "surface",
      "default": true,
      "maps_to": "send_user_names",
      "requires": "protocol"
    },
    {
      "key": "stereo_to_mono",
      "label": "Map Stereo to 2 Mono Channels",
      "form": "checkbox",
      "group": "surface",
      "default": false,
      "maps_to": "stereo_to_mono",
      "requires": "protocol"
    },
    {
      "key": "submix_any_row",
      "label": "Submix Selection in Input/Playback Row",
      "form": "checkbox",
      "group": "surface",
      "default": false,
      "maps_to": "submix_any_row",
      "requires": "protocol"
    },
    {
      "key": "background_disable",
      "label": "Disable MIDI in background",
      "form": "checkbox",
      "group": "surface",
      "default": false,
      "maps_to": "background_disable"
    },
    {
      "key": "send_levels",
      "label": "Send level messages",
      "form": "checkbox",
      "group": "feedback",
      "default": false,
      "maps_to": "send_level_messages"
    },
    {
      "key": "peak_hold",
      "label": "Peak hold",
      "form": "checkbox",
      "group": "feedback",
      "default": false,
      "maps_to": "peak_hold",
      "requires": "send_levels"
    }
  ],
  "boolean_encodings": {
    "on_off": {
      "on": {
        "kind": "note",
        "velocity": 127
      },
      "off": {
        "kind": "note",
        "velocity": 0
      }
    }
  },
  "numeric": {
    "vpotturn": {
      "kind": "relative",
      "encoding": "relative_7bit"
    },
    "jog": {
      "kind": "relative",
      "encoding": "relative_7bit"
    },
    "fader": {
      "kind": "absolute",
      "encoding": "absolute_14bit",
      "order": "low_first"
    },
    "cc7": {
      "kind": "absolute",
      "encoding": "absolute_7bit"
    },
    "ring": {
      "kind": "absolute",
      "encoding": "ring_position"
    },
    "meter": {
      "kind": "absolute",
      "encoding": "mackie_meter_nibble"
    },
    "lcd_text": {
      "kind": "text",
      "encoding": "ascii"
    },
    "loopback_vel": {
      "kind": "constant",
      "value": 90
    }
  },
  "controls": [
    {
      "id": "fader",
      "label": "Strip fader",
      "kind": "pitch_bend",
      "channel": 1,
      "expand": {
        "axis": "channel",
        "count": 8
      },
      "value": "fader",
      "action": "strip_volume"
    },
    {
      "id": "master_fader",
      "label": "Master fader",
      "kind": "pitch_bend",
      "channel": 9,
      "value": "fader",
      "action": "master_volume"
    },
    {
      "id": "vpot",
      "label": "VPOT",
      "kind": "cc",
      "message": 16,
      "channel": 1,
      "expand": {
        "axis": "cc",
        "count": 8
      },
      "value": "vpotturn",
      "action": "strip_pan"
    },
    {
      "id": "vpot_push",
      "label": "VPOT push",
      "kind": "note",
      "note": 32,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 8
      },
      "action": "strip_pan_center"
    },
    {
      "id": "rec",
      "label": "REC",
      "kind": "note",
      "note": 0,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 8
      },
      "action": "submix_select"
    },
    {
      "id": "solo",
      "label": "SOLO",
      "kind": "note",
      "note": 8,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 8
      },
      "action": "strip_solo"
    },
    {
      "id": "mute",
      "label": "MUTE",
      "kind": "note",
      "note": 16,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 8
      },
      "action": "strip_mute"
    },
    {
      "id": "select",
      "label": "SELECT",
      "kind": "note",
      "note": 24,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 8
      },
      "action": "strip_select"
    },
    {
      "id": "fader_touch",
      "label": "Fader touch",
      "kind": "note",
      "note": 104,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 9
      },
      "action": "none"
    },
    {
      "id": "assign_track",
      "label": "ASSIGN TRACK",
      "kind": "note",
      "note": 40,
      "channel": 1,
      "action": "none"
    },
    {
      "id": "assign_send",
      "label": "ASSIGN SEND",
      "kind": "note",
      "note": 41,
      "channel": 1,
      "action": "none"
    },
    {
      "id": "pan",
      "label": "PAN (Mono)",
      "kind": "note",
      "note": 42,
      "channel": 1,
      "action": "mono"
    },
    {
      "id": "plugin",
      "label": "PLUGINS (master solo)",
      "kind": "note",
      "note": 43,
      "channel": 1,
      "action": "master_solo"
    },
    {
      "id": "eq",
      "label": "EQ (master mute)",
      "kind": "note",
      "note": 44,
      "channel": 1,
      "action": "mute_main"
    },
    {
      "id": "instrument",
      "label": "DYN (Trim Gains)",
      "kind": "note",
      "note": 45,
      "channel": 1,
      "action": "trim_mode"
    },
    {
      "id": "bank_left",
      "label": "BANK LEFT",
      "kind": "note",
      "note": 46,
      "channel": 1,
      "action": "navigate",
      "argument": "bank_left"
    },
    {
      "id": "bank_right",
      "label": "BANK RIGHT",
      "kind": "note",
      "note": 47,
      "channel": 1,
      "action": "navigate",
      "argument": "bank_right"
    },
    {
      "id": "channel_left",
      "label": "CHANNEL LEFT",
      "kind": "note",
      "note": 48,
      "channel": 1,
      "action": "navigate",
      "argument": "channel_left"
    },
    {
      "id": "channel_right",
      "label": "CHANNEL RIGHT",
      "kind": "note",
      "note": 49,
      "channel": 1,
      "action": "navigate",
      "argument": "channel_right"
    },
    {
      "id": "flip",
      "label": "FLIP (Speaker B)",
      "kind": "note",
      "note": 50,
      "channel": 1,
      "action": "speaker_b"
    },
    {
      "id": "global_view",
      "label": "GLOBAL VIEW",
      "kind": "note",
      "note": 51,
      "channel": 1,
      "action": "none"
    },
    {
      "id": "f1",
      "label": "F1-F8 (Snapshot)",
      "kind": "note",
      "note": 54,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 8
      },
      "action": "snapshot",
      "argument": {
        "expr": "note - 53"
      }
    },
    {
      "id": "f9",
      "label": "F9 (Main Out)",
      "kind": "note",
      "note": 62,
      "channel": 1,
      "action": "select_cue_main"
    },
    {
      "id": "f10",
      "label": "F10-F12 (Cue Phones)",
      "kind": "note",
      "note": 63,
      "channel": 1,
      "expand": {
        "axis": "note",
        "count": 4
      },
      "action": "cue_phones",
      "argument": {
        "expr": "note - 62"
      }
    },
    {
      "id": "rewind",
      "label": "REWIND",
      "kind": "note",
      "note": 91,
      "channel": 1,
      "action": "navigate",
      "argument": "channel_left"
    },
    {
      "id": "forward",
      "label": "FAST FORWARD",
      "kind": "note",
      "note": 92,
      "channel": 1,
      "action": "navigate",
      "argument": "channel_right"
    },
    {
      "id": "stop",
      "label": "STOP (Dim)",
      "kind": "note",
      "note": 93,
      "channel": 1,
      "action": "dim"
    },
    {
      "id": "play",
      "label": "PLAY (Talkback)",
      "kind": "note",
      "note": 94,
      "channel": 1,
      "action": "talkback"
    },
    {
      "id": "record",
      "label": "RECORD (Recall)",
      "kind": "note",
      "note": 95,
      "channel": 1,
      "action": "recall_volume"
    },
    {
      "id": "row_up",
      "label": "ARROW UP",
      "kind": "note",
      "note": 96,
      "channel": 1,
      "action": "navigate",
      "argument": "row_up"
    },
    {
      "id": "row_down",
      "label": "ARROW DOWN",
      "kind": "note",
      "note": 97,
      "channel": 1,
      "action": "navigate",
      "argument": "row_down"
    },
    {
      "id": "cursor_left",
      "label": "CURSOR LEFT",
      "kind": "note",
      "note": 98,
      "channel": 1,
      "action": "navigate",
      "argument": "bank_left"
    },
    {
      "id": "cursor_right",
      "label": "CURSOR RIGHT",
      "kind": "note",
      "note": 99,
      "channel": 1,
      "action": "navigate",
      "argument": "bank_right"
    },
    {
      "id": "zoom",
      "label": "ZOOM",
      "kind": "note",
      "note": 100,
      "channel": 1,
      "action": "none"
    },
    {
      "id": "scrub",
      "label": "SCRUB",
      "kind": "note",
      "note": 101,
      "channel": 1,
      "action": "none"
    },
    {
      "id": "user1",
      "label": "Assignable 1 (PAGE+)",
      "kind": "note",
      "note": 102,
      "channel": 1,
      "action": "navigate",
      "argument": "row_up"
    },
    {
      "id": "user2",
      "label": "Assignable 2 (PAGE-)",
      "kind": "note",
      "note": 103,
      "channel": 1,
      "action": "navigate",
      "argument": "row_down"
    },
    {
      "id": "jog",
      "label": "Jog wheel",
      "kind": "cc",
      "message": 60,
      "channel": 1,
      "value": "jog",
      "action": "none"
    },
    {
      "id": "cc_volume",
      "label": "CC 7 Volume (ch 1)",
      "kind": "cc",
      "message": 7,
      "channel": 1,
      "value": "cc7",
      "simple": true,
      "action": "master_volume"
    },
    {
      "id": "cc_input_gain",
      "label": "CC 9 Input gain",
      "kind": "cc",
      "message": 9,
      "channel_range": [
        1,
        12
      ],
      "value": "cc7",
      "simple": true,
      "action": "input_gain",
      "argument": {
        "expr": "channel - 1"
      }
    },
    {
      "id": "cc_input_gain_hi",
      "label": "CC 9 Input gain (ch 14-16)",
      "kind": "cc",
      "message": 9,
      "channel_range": [
        14,
        16
      ],
      "value": "cc7",
      "simple": true,
      "action": "input_gain",
      "argument": {
        "expr": "channel - 1"
      }
    },
    {
      "id": "row_faders",
      "label": "CC 102-117 row faders",
      "kind": "cc",
      "message": 102,
      "channel_range": [
        1,
        12
      ],
      "expand": {
        "axis": "cc",
        "count": 16
      },
      "value": "cc7",
      "simple": true,
      "action": "row_fader",
      "argument": {
        "expr": "((channel - 1) / 4) * 64 + ((channel - 1) % 4) * 16 + (cc - 102)"
      }
    },
    {
      "id": "trim_on",
      "label": "CC 102 Trim Gains on (ch 13)",
      "kind": "cc",
      "message": 102,
      "channel": 13,
      "value": "cc7",
      "simple": true,
      "action": "trim_on"
    },
    {
      "id": "trim_off",
      "label": "CC 103 Trim Gains off (ch 13)",
      "kind": "cc",
      "message": 103,
      "channel": 13,
      "value": "cc7",
      "simple": true,
      "action": "trim_off"
    },
    {
      "id": "submix_cc",
      "label": "CC 104+ Submix select (ch 13)",
      "kind": "cc",
      "message": 104,
      "channel": 13,
      "expand": {
        "axis": "cc",
        "count": 24
      },
      "value": "cc7",
      "simple": true,
      "action": "submix_select_index",
      "argument": {
        "expr": "(cc - 104) / 2"
      }
    }
  ],
  "feedback": [
    {
      "id": "fader",
      "enabled_by": "protocol",
      "kind": "pitch_bend",
      "address": {
        "channel": 1,
        "expand": {
          "axis": "channel",
          "count": 8
        }
      },
      "state": "strip.fader",
      "value": "fader",
      "sync": true
    },
    {
      "id": "mute_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 16,
        "channel": 1,
        "expand": {
          "axis": "note",
          "count": 8
        }
      },
      "state": "strip.mute",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "solo_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 8,
        "channel": 1,
        "expand": {
          "axis": "note",
          "count": 8
        }
      },
      "state": "strip.solo",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "select_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 24,
        "channel": 1,
        "expand": {
          "axis": "note",
          "count": 8
        }
      },
      "state": "strip.select",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "rec_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 0,
        "channel": 1,
        "expand": {
          "axis": "note",
          "count": 8
        }
      },
      "state": "strip.rec",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "ring",
      "enabled_by": "protocol",
      "kind": "cc",
      "address": {
        "cc": 48,
        "channel": 1,
        "expand": {
          "axis": "cc",
          "count": 8
        }
      },
      "state": "strip.pan",
      "value": "ring",
      "sync": true
    },
    {
      "id": "master_fader",
      "enabled_by": "protocol",
      "kind": "pitch_bend",
      "address": {
        "channel": 9
      },
      "state": "master.fader",
      "value": "fader",
      "sync": true
    },
    {
      "id": "dim_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 93,
        "channel": 1
      },
      "state": "main.dim",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "talkback_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 94,
        "channel": 1
      },
      "state": "main.talkback",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "mono_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 42,
        "channel": 1
      },
      "state": "main.mono",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "speaker_b_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 50,
        "channel": 1
      },
      "state": "main.speaker_b",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "master_mute_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 44,
        "channel": 1
      },
      "state": "main.mute",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "master_solo_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 43,
        "channel": 1
      },
      "state": "main.solo",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "trim_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 45,
        "channel": 1
      },
      "state": "nav.trim",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "rude_solo_led",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 115,
        "channel": 1
      },
      "state": "main.rude_solo",
      "value": "on_off",
      "sync": true
    },
    {
      "id": "lcd",
      "enabled_by": "protocol",
      "kind": "sysex",
      "address": {
        "header": "f0 00 00 66 14 12"
      },
      "state": "lcd",
      "value": "lcd_text",
      "sync": true
    },
    {
      "id": "meter",
      "enabled_by": "send_levels",
      "kind": "channel_pressure",
      "address": {
        "channel": 1,
        "expand": {
          "axis": "index",
          "count": 8
        },
        "index_nibble": "high"
      },
      "state": "meter",
      "value": "meter",
      "sync": false,
      "rate_hz": 25
    },
    {
      "id": "loopback",
      "enabled_by": "protocol",
      "kind": "note",
      "address": {
        "note": 127,
        "channel": 16
      },
      "state": "loopback",
      "value": "loopback_vel",
      "sync": false,
      "period_ms": 500
    }
  ],
  "extra": {
    "handshake": "mackie",
    "tables": {
      "cue_phones_range": [
        1,
        2,
        3,
        4
      ],
      "input_gain_max": {
        "uc": 65,
        "ucx": 65,
        "babyface_classic": 60
      }
    }
  }
}
