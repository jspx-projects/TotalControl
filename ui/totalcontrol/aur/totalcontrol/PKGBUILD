# Maintainer: ismail-bahloul <iswadlillah@gmail.com>

# TotalControl — Open-source TotalMix replacement for RME audio interfaces on Linux
#
# Building from source requires Rust (cargo) and ALSA development headers.
#
# When a new version is tagged on GitHub, update pkgver and the source
# tarball checksum below.

pkgname=totalcontrol
pkgver=0.3.1
pkgrel=1
pkgdesc="Open-source TotalMix replacement for RME audio interfaces on Linux"
arch=('x86_64')
url="https://github.com/jspx-projects/TotalControl"
# totalcontrol-gui and totalcontrol-tui are GPL-3.0-only; totalcontrol-core is MIT.
# totalcontrol-gui links totalcontrol-usb (GPL-3.0-or-later) and totalcontrol-sys
# (GPL-3.0), so the binaries this package installs are GPL-3.0 as a
# whole. See the repo's LICENSE and COPYING.
license=('GPL3')
depends=(
    'alsa-lib'
    'libgl'
    'systemd-libs'
)
makedepends=(
    'cargo'
)
# totalcontrol-usb vendors and compiles libusb from C source (rusb's
# "vendored" feature — no runtime libusb dependency needed as a
# result). makepkg's default LTO CFLAGS break that vendored build
# (mixes LTO bitcode objects into a non-LTO Rust link, ending in
# "undefined symbol: libusb_*" — reproduced and confirmed locally):
# disable LTO for this package specifically.
options=('!lto')
# GitHub names the archive after the repo's real casing (TotalControl-*),
# not the lowercase pkgname — build()/package() cd into that below.
source=("${url}/archive/v${pkgver}/TotalControl-${pkgver}.tar.gz")
sha256sums=('2ad00bdc366cc51af3efcbf28d5ecd600951d247cb6ea114e1d5eb07aac3d7c1')

build() {
    cd "${srcdir}/TotalControl-${pkgver}"
    cargo build --release --workspace
}

package() {
    cd "${srcdir}/TotalControl-${pkgver}"

    install -Dm755 "target/release/totalcontrol-gui" \
        "${pkgdir}/usr/bin/totalcontrol"
    install -Dm755 "target/release/totalcontrol-tui" \
        "${pkgdir}/usr/bin/totalcontrol-tui"

    install -Dm644 "totalcontrol-gui/assets/totalcontrol.desktop" \
        "${pkgdir}/usr/share/applications/totalcontrol.desktop"
    install -Dm644 "totalcontrol-gui/assets/totalcontrol.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/totalcontrol.svg"
    install -Dm644 "totalcontrol-gui/assets/totalcontrol-128.png" \
        "${pkgdir}/usr/share/icons/hicolor/128x128/apps/totalcontrol.png"
    install -Dm644 "totalcontrol-gui/assets/totalcontrol-256.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/totalcontrol.png"

    install -Dm644 "README.md" \
        "${pkgdir}/usr/share/doc/totalcontrol/README.md"
}
