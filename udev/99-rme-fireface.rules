# RME Fireface UC / Babyface — allow the desktop user to access the
# vendor-specific USB interfaces without root.
#
# Installed by scripts/setup.sh.
#
# The UC presents three product IDs, one per personality: PC (interrupt
# transport), AP (isochronous transport) and Win RME.  Each needs an entry
# for the USB tools and for TotalControl to reach the unit directly.

# Fireface UCX
SUBSYSTEM=="usb", ATTR{idVendor}=="0424", ATTR{idProduct}=="3fc9", MODE="0660", GROUP="audio", TAG+="uaccess"

# Fireface UC, PC personality
SUBSYSTEM=="usb", ATTR{idVendor}=="0424", ATTR{idProduct}=="3fc5", MODE="0660", GROUP="audio", TAG+="uaccess"

# Fireface UC, AP personality
SUBSYSTEM=="usb", ATTR{idVendor}=="0424", ATTR{idProduct}=="3fc6", MODE="0660", GROUP="audio", TAG+="uaccess"

# Babyface classic
SUBSYSTEM=="usb", ATTR{idVendor}=="0424", ATTR{idProduct}=="3fc7", MODE="0660", GROUP="audio", TAG+="uaccess"

# RME VID (UC PC/AP/Win, UCX II, Babyface Pro FS, ...)
SUBSYSTEM=="usb", ATTR{idVendor}=="2a39", ATTR{idProduct}=="3f*", MODE="0660", GROUP="audio", TAG+="uaccess"
