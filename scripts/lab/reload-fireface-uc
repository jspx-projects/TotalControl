#!/bin/sh
# Reload the Fireface UC/UCX transport module.
#
# Installed as /usr/local/sbin/reload-fireface-uc with a NOPASSWD sudoers
# rule.  It accepts no arguments.
#
# The module is discovered, not fixed to one checkout: a stable installed
# copy is preferred, otherwise the newest build in any checkout is used.
#
# A reload needs the module unreferenced: the audio graph (PipeWire holding
# the PCM) and any hwdep holder keep it loaded. If rmmod fails, the helper
# re-binds the interfaces it unbound (restoring audio on the loaded module)
# and reports the holders; it never leaves the unit unbound. For a true
# swap while a graph holds the device, use scripts/bench-reload.sh, which
# stops the graph first.
set -eu

KO=/usr/local/lib/ff-lab/snd-fireface-uc.ko
if [ ! -f "$KO" ]; then
    KO=$(find /home /opt -maxdepth 7 -type f \
              -path '*/kernel/snd-fireface-uc.ko' -printf '%T@ %p\n' 2>/dev/null |
         sort -nr | head -1 | cut -d' ' -f2-)
fi
[ -n "${KO:-}" ] && [ -f "$KO" ] || { echo "no snd-fireface-uc.ko found" >&2; exit 1; }

# Do not load a world-writable module file.
case $(ls -l "$KO" | cut -c9) in
    w) echo "refusing world-writable module: $KO" >&2; exit 1 ;;
esac

echo "loading $KO"
IFACES=$(ls -d /sys/bus/usb/drivers/snd-fireface-uc/*:*.* 2>/dev/null |
         xargs -r -n1 basename || true)
for i in $IFACES; do
    echo -n "$i" > /sys/bus/usb/drivers/snd-fireface-uc/unbind || true
done

if ! rmmod snd_fireface_uc 2>/dev/null; then
    sleep 2
    if ! rmmod snd_fireface_uc 2>/dev/null; then
        # The module is still referenced. Restore the interfaces so the
        # unit keeps working on the loaded module, and report the holders.
        for i in $IFACES; do
            echo -n "$i" > /sys/bus/usb/drivers/snd-fireface-uc/bind 2>/dev/null || true
        done
        echo "reload skipped: snd_fireface_uc is in use; interfaces re-bound" >&2
        echo "refcnt: $(cat /sys/module/snd_fireface_uc/refcnt 2>/dev/null || echo '?')" >&2
        fuser -v /dev/snd/* 2>&1 | sed 's/^/holder: /' >&2 || true
        echo "stop the audio graph first (scripts/bench-reload.sh) for a true swap" >&2
        exit 1
    fi
fi

modprobe snd-pcm || true
if ! insmod "$KO"; then
    echo "insmod failed; the module is unloaded and the unit is offline" >&2
    echo "recover: sudo -n reset-fireface-usb, then re-run this helper" >&2
    exit 1
fi
sleep 2

echo '--- cards ---'
cat /proc/asound/cards
echo '--- hwdep ---'
ls -l /dev/snd/hwC*D* 2>/dev/null || true